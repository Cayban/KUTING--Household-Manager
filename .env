# Copy this file to .env for local dev, and add the same values as
# Environment Variables in your Vercel project settings for deployment.
# Get these from: Firebase console > Project settings > General > Your apps > SDK setup and config

# Want to preview the UI before setting up Firebase at all? Set this to
# "true" and leave everything else blank — the app will run on local mock
# data (3 sample siblings, chores in every status, notes, history). No
# Firebase project needed. Set back to "false" (or remove it) once you're
# ready to connect the real database.
VITE_DEMO_MODE=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
